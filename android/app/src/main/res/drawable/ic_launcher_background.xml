<?xml version="1.0" encoding="utf-8"?>
<!-- Color Brawl launcher background: the game's own deep-navy ink field, with a subtle
     radial lift so the orange squid reads clearly on both light and dark launchers. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="50"
                android:gradientRadius="72"
                android:startColor="#FF1B2244"
                android:endColor="#FF0A0D1C" />
        </aapt:attr>
    </path>
</vector>
