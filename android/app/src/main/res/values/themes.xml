<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ColorBrawl" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/ink_navy</item>
        <item name="android:colorBackground">@color/ink_navy</item>
    </style>

    <!-- Immersive fullscreen: the game draws edge to edge; the Android touch layer respects
         the display cutout itself via CSS env(safe-area-inset-*). -->
    <style name="Theme.ColorBrawl.Fullscreen" parent="Theme.ColorBrawl">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
